# Required. Local values match docker-compose.yml. S3 keys are server-only; never prefix them NEXT_PUBLIC_.
DATABASE_URL=postgres://benrey:benrey_local_only@localhost:54329/benrey
PAYLOAD_SECRET=change-me
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=benrey-media
S3_ACCESS_KEY_ID=benrey_minio
S3_SECRET_ACCESS_KEY=benrey_minio_local_only

# Optional
NEXT_PUBLIC_SERVER_URL=http://localhost:3000
S3_FORCE_PATH_STYLE=true
PAYLOAD_MIGRATE_ON_INIT=

# Optional AI helper
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# Seed only
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change-me-admin
SEED_STAFF_EMAIL=staff@example.com
SEED_STAFF_PASSWORD=change-me-staff
